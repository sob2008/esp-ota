name: Build and release firmware

# Sablona - zkopirujte do <projekt>/.github/workflows/release.yml a upravte
# 3 veci oznacene "<<...>>" nize (slozka sketch, FQBN desky, seznam knihoven).
#
# Spousti se pouze rucnim vytvorenim a pushnutim tagu ve tvaru vX.Y.Z, napr.:
#   git tag v1.2.0
#   git push origin v1.2.0
#
# Workflow zkompiluje sketch, overi, ze FIRMWARE_VERSION v OtaConfig.h
# odpovida pushnutemu tagu, vytvori firmware.bin, firmware.json a
# firmware.bin.sha256 a nahraje je jako assety do GitHub Release se stejnym
# tagem. Format assetu musi presne odpovidat tomu, co ocekava OtaManager
# (viz ../README.md v tomto balicku).

on:
  push:
    tags:
      - "v*.*.*"

permissions:
  contents: write

jobs:
  build-and-release:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Install arduino-cli
        uses: arduino/setup-arduino-cli@v2

      - name: Install board core
        run: |
          # <<Pro ESP8266 nechte tento radek. Pro ESP32 pouzijte:
          #    arduino-cli core update-index
          #    arduino-cli core install esp32:esp32>>
          arduino-cli config init --additional-urls https://arduino.esp8266.com/stable/package_esp8266com_index.json
          arduino-cli core update-index
          arduino-cli core install esp8266:esp8266

      - name: Install libraries
        run: |
          # <<Doplnte presne ty knihovny, ktere vas sketch skutecne pouziva
          #   (napr. displej, senzory...). ArduinoJson je vzdy potreba (OTA
          #   klient na ni zavisi), WiFiManager jen pokud ho pouzivate pro
          #   WiFi provisioning.>>
          arduino-cli lib install "ArduinoJson" "WiFiManager"

      - name: Read FIRMWARE_VERSION / FIRMWARE_TARGET from OtaConfig.h
        id: fw
        run: |
          set -e
          # <<Cesta k OtaConfig.h ve vasem repozitari>>
          CONFIG="<<sketch-dir>>/OtaConfig.h"
          FW_VERSION=$(sed -n 's/^#define FIRMWARE_VERSION "\(.*\)"/\1/p' "$CONFIG")
          FW_TARGET=$(sed -n 's/^#define FIRMWARE_TARGET "\(.*\)"/\1/p' "$CONFIG")
          if [ -z "$FW_VERSION" ] || [ -z "$FW_TARGET" ]; then
            echo "::error::Nepodarilo se precist FIRMWARE_VERSION/FIRMWARE_TARGET z $CONFIG"
            exit 1
          fi
          echo "version=$FW_VERSION" >> "$GITHUB_OUTPUT"
          echo "target=$FW_TARGET" >> "$GITHUB_OUTPUT"

      - name: Verify tag matches FIRMWARE_VERSION
        run: |
          set -e
          TAG_VERSION="${GITHUB_REF_NAME#v}"
          if [ "$TAG_VERSION" != "${{ steps.fw.outputs.version }}" ]; then
            echo "::error::Tag ${GITHUB_REF_NAME} (verze $TAG_VERSION) neodpovida FIRMWARE_VERSION v OtaConfig.h (${{ steps.fw.outputs.version }}). Uprav FIRMWARE_VERSION a vytvor tag znovu."
            exit 1
          fi

      - name: Compile firmware
        run: |
          arduino-cli compile \
            --fqbn <<esp8266:esp8266:d1_mini>> \
            --warnings all \
            --export-binaries \
            <<sketch-dir>>

      - name: Prepare release assets
        run: |
          set -e
          mkdir -p release
          # <<arduino-cli export-binaries vytvori .bin pod
          #   <sketch-dir>/build/<fqbn-s-podtrzitky>/<sketch-nazev>.ino.bin -
          #   uprav podle skutecneho FQBN a nazvu sketch.>>
          BIN_SRC="<<sketch-dir>>/build/<<esp8266.esp8266.d1_mini>>/<<sketch-nazev>>.ino.bin"
          cp "$BIN_SRC" release/firmware.bin

          SIZE=$(stat -c%s release/firmware.bin)
          SHA256=$(sha256sum release/firmware.bin | cut -d' ' -f1)

          echo "$SHA256  firmware.bin" > release/firmware.bin.sha256

          cat > release/firmware.json <<EOF
          {
            "version": "${{ steps.fw.outputs.version }}",
            "target": "${{ steps.fw.outputs.target }}",
            "firmware_size": $SIZE,
            "sha256": "$SHA256"
          }
          EOF

          echo "Firmware: $SIZE bajtu, sha256=$SHA256"

      - name: Create GitHub Release
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -e
          gh release create "${GITHUB_REF_NAME}" \
            release/firmware.bin \
            release/firmware.json \
            release/firmware.bin.sha256 \
            --title "${GITHUB_REF_NAME}" \
            --generate-notes
